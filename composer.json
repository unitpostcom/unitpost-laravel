{
  "name": "unitpost/laravel",
  "description": "Laravel wrapper for the official Unitpost PHP SDK.",
  "type": "library",
  "license": "MIT",
  "version": "0.4.0",
  "homepage": "https://www.unitpost.com/docs",
  "support": {
    "issues": "https://github.com/unitpostcom/unitpost-laravel/issues",
    "source": "https://github.com/unitpostcom/unitpost-laravel"
  },
  "require": {
    "php": ">=8.2",
    "illuminate/support": ">=10.0",
    "unitpost/unitpost": "^0.4.0"
  },
  "autoload": {
    "psr-4": { "Unitpost\\Laravel\\": "src/" }
  },
  "extra": {
    "laravel": {
      "providers": ["Unitpost\\Laravel\\UnitpostServiceProvider"],
      "aliases": { "Unitpost": "Unitpost\\Laravel\\Facades\\Unitpost" }
    }
  },
  "minimum-stability": "stable"
}
